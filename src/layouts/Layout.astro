---
import '../styles/global.css';
import site from '../../site.config.json';
const {title='Free Resume & CV Builder',description='Build, edit and download your resume for free. Import a PDF or Word CV, choose a clean template, and apply with confidence. No account needed.',active='builder',noindex=false}=Astro.props;
const origin=import.meta.env.PUBLIC_SITE_URL||site.origin;
const canonical=origin?new URL(Astro.url.pathname,origin).href:undefined;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#18674d"/><meta name="robots" content={noindex?'noindex,nofollow':'index,follow'}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={`${title} | GlobalCV`}/><meta property="og:description" content={description}/><title>{title} | GlobalCV</title></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><a class="brand" href="/" aria-label="GlobalCV home"><img src="/favicon.svg" width="33" height="33" alt=""/><span>Global<span class="brand-light">CV</span><sup>FREE</sup></span></a><nav aria-label="Main navigation"><a href="/" class:list={{active:active==='builder'}}>Resume builder</a><a href="/templates/" class:list={{active:active==='templates'}}>Templates</a><a href="/guides/" class:list={{active:active==='guides'}}>Career guides</a></nav><div class="header-account"><a href="/dashboard/" class="draft-link">My drafts</a><a class="header-login" href="/login/">Log in <span aria-hidden="true">↗</span></a></div></header><slot/><footer class="site-footer"><a class="brand footer-brand" href="/">Global<span class="brand-light">CV</span></a><p>Your experience. Your next opportunity.</p><div><a href="/about/">About</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/guides/">Guides</a></div><span>© {new Date().getFullYear()} GlobalCV</span></footer><script>
function showAccount(user: {id:string}|null){const link=document.querySelector('.header-login');if(link){link.textContent=user?'My account':'Log in';link.setAttribute('href',user?'/dashboard/':'/login/');}}
fetch('/api/me').then(r=>r.ok?r.json():null).then(data=>showAccount(data?.user)).catch(()=>{});
window.addEventListener('globalcv-account',event=>showAccount((event as CustomEvent).detail));
</script></body></html>
