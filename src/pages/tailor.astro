---
import Layout from '../layouts/Layout.astro';
import Tailor from '../components/Tailor';
---
<Layout title="Tailor Your CV to a Job Description" description="Upload your existing CV, add a job description and review evidence-based AI suggestions. Approve changes before downloading a separate tailored resume." active="tailor"><main id="main" class="content-page tailor-page"><div class="page-heading"><span class="eyebrow">YOUR EXPERIENCE. THIS OPPORTUNITY.</span><h1>Make your CV relevant.</h1><p>Start with your experience. Bring the right details forward for your next application.</p></div><Tailor client:load/></main></Layout>
