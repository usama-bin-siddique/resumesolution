---
import Layout from '../layouts/Layout.astro';
import ResumePreview from '../components/ResumePreview';
import {example} from '../lib/resume';
const markets=[['United States','usa','US'],['United Kingdom','uk','UK'],['United Arab Emirates','uae','AE'],['Saudi Arabia','saudi-arabia','SA'],['Pakistan','pakistan','PK']];
---
<Layout title="Free Resume Builder & AI CV Tailoring" active="home" description="Create a resume, update an existing CV or tailor it to a job. Explore free templates and country guides. Download your PDF without creating an account.">
<main id="main" class="home-page">
<section class="home-hero home-wrap">
<div class="home-hero-copy"><span class="eyebrow"><span class="tiny-line"></span> YOUR NEXT CHAPTER STARTS HERE</span><h1>Your experience.<br/>A stronger <em>first impression.</em></h1><p>Create a clear, professional resume or shape your existing CV for the job you want. Simple tools. Thoughtful templates. Always your words to approve.</p><div class="home-actions"><a class="button primary" href="/builder/">Build my resume <span aria-hidden="true">↗</span></a><a class="button secondary" href="/tailor/">Tailor my CV <span aria-hidden="true">→</span></a></div><p class="home-reassurance"><span aria-hidden="true">✓</span> Free PDF downloads <span aria-hidden="true">·</span> No signup required</p></div>
<div class="home-showcase"><div class="home-paper-label"><span class="home-dot"></span> A CLEARER PICTURE OF YOU <span>01 / 15</span></div><div class="home-sample" aria-hidden="true"><ResumePreview resume={{...example,template:'classic'}} mini/></div><div class="home-paper-note"><span class="home-check" aria-hidden="true">✓</span><div><strong>Ready for your next opportunity</strong><span>Clean layout. Your experience at the centre.</span></div></div><span class="home-sample-caption">Example resume · Classic template</span></div>
</section>
<section class="home-benefits"><div class="home-wrap"><span><strong>15</strong> free resume templates</span><span><strong>PDF · DOCX · TXT</strong> import your existing CV</span><span><strong>You stay in control</strong> review every AI suggestion</span></div></section>
<section id="tools" class="home-wrap home-section"><div class="home-section-heading"><div><span class="eyebrow">THE RIGHT TOOL FOR YOUR NEXT STEP</span><h2>Where would you like to start?</h2></div><p>Start fresh, update what you have, or make your experience more relevant to a specific role.</p></div><div class="home-tools"><article class="home-tool"><span class="home-tool-icon" aria-hidden="true">▤</span><span class="home-tool-label">CREATE & EDIT</span><h3>A resume that feels like you.</h3><p>Enter your details or import an existing CV. Edit each section, choose a template and see your resume take shape.</p><ul><li>Start from scratch or upload a document</li><li>Personalize the layout and section order</li><li>Download a free, text-based PDF</li></ul><a href="/builder/" class="button primary">Open resume builder <span aria-hidden="true">→</span></a></article><article class="home-tool home-tool-tint"><span class="home-tool-icon" aria-hidden="true">✧</span><span class="home-tool-label">TAILOR & REFINE</span><h3>Your experience. Their opportunity.</h3><p>Bring your CV and a job description. Get AI suggestions that help bring your relevant experience into focus.</p><ul><li>Compare original and suggested wording</li><li>Choose, edit and approve each change</li><li>Download a separate copy of your CV</li></ul><a href="/tailor/" class="button primary">Tailor my CV to a job <span aria-hidden="true">→</span></a><small>5 requests daily · Guest allowance is shared per network</small></article></div></section>
<section class="home-process"><div class="home-wrap home-section"><span class="eyebrow">LESS FRICTION. MORE PROGRESS.</span><h2>From first draft to ready to send.</h2><div class="home-steps">{[['01','Bring your story','Add your experience, education and skills, or import the CV you already have.'],['02','Make it your own','Choose a clear template, refine your wording and check that every detail is accurate.'],['03','Take the next step','Download your PDF for free. Want to return later? Log in to save a private draft.']].map(([n,title,copy])=><article><span>{n}</span><h3>{title}</h3><p>{copy}</p></article>)}</div></div></section>
<section class="home-wrap home-section"><div class="home-section-heading"><div><span class="eyebrow">GOOD DESIGN GETS OUT OF THE WAY</span><h2>Let your experience stand out.</h2></div><a class="text-button" href="/templates/">Explore all 15 templates →</a></div><div class="home-template-grid">{[['classic','Classic','Simple, familiar and versatile.'],['executive','Executive','A considered, traditional finish.'],['meridian','Meridian','A modern touch of colour.']].map(([id,name,copy])=><a class="home-template" href={`/builder/?template=${id}`}><div class="home-template-preview" aria-hidden="true"><ResumePreview resume={{...example,template:id}} mini/></div><div class="home-template-info"><div><h3>{name}</h3><p>{copy}</p></div><span aria-label={`Use ${name} template`}>↗</span></div></a>)}</div><p class="home-caption">Standard sections and selectable PDF text support clear reading. No template guarantees an ATS result or an interview.</p></section>
<section class="home-wrap home-country"><div><span class="eyebrow">A LITTLE LOCAL CONTEXT</span><h2>Your next role could be anywhere.</h2><p>Explore practical CV guidance for your destination. Requirements vary by employer, so always follow the job listing.</p></div><div class="home-country-links">{markets.map(([name,slug,code])=><a href={`/countries/${slug}/`}><span>{code}</span>{name}<b aria-hidden="true">↗</b></a>)}</div></section>
<section class="home-wrap home-section home-faq"><div><span class="eyebrow">BEFORE YOU BEGIN</span><h2>A few helpful answers.</h2><a class="text-button" href="/guides/">Read our career guides →</a></div><div><details><summary>Is GlobalCV free to use?</summary><p>Yes. You can create, edit and download your resume as a PDF for free. AI tailoring has a limit of five requests per day and depends on the free AI service’s available capacity.</p></details><details><summary>Do I need to create an account?</summary><p>No account is needed to create or download your resume. Log in or create a free account when you want to save private drafts and access them later.</p></details><details><summary>Can I update a resume I already have?</summary><p>Yes. Import a text-based PDF, DOCX or TXT file, then review the extracted details in the editor. Importing recovers content, not the original formatting. Scanned PDFs need OCR first.</p></details><details><summary>Will AI changes overwrite my original CV?</summary><p>No. You review the suggestions, edit the wording if needed and approve the changes you want. The tailored CV is created as a separate copy. Check every claim before applying.</p></details></div></section>
<section class="home-wrap home-final"><div><span class="eyebrow">MAKE ROOM FOR WHAT’S NEXT</span><h2>A fresh start for your next application.</h2><p>Your experience is already there. Let’s help you present it.</p></div><a href="/builder/" class="button primary">Create my resume <span aria-hidden="true">→</span></a></section>
</main>
<script>
// Preserve existing shared builder links from before the homepage was introduced.
const params=new URLSearchParams(location.search);
if(['draft','template','country','save'].some(key=>params.has(key)))location.replace('/builder/'+location.search+location.hash);
</script>
</Layout>
<style>
.home-wrap{width:min(1180px,90%);margin-inline:auto}.home-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:80px;align-items:center;padding-block:76px 70px}.home-hero h1{font-size:clamp(40px,4.4vw,61px);line-height:1.12;letter-spacing:-2.5px;margin:23px 0}.home-hero h1 em{font-style:normal;color:var(--green)}.home-hero-copy>p{font-size:17px;color:#64736a;max-width:505px}.home-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.home-actions .button{padding:14px 21px}.home-hero-copy .home-reassurance{font-size:12px;margin-top:17px;display:flex;gap:10px;align-items:center}.home-showcase{position:relative;background:#e9f0e9;border-radius:18px;padding:24px 35px 19px;transform:rotate(2deg)}.home-paper-label{display:flex;align-items:center;gap:7px;font-size:9px;letter-spacing:1px;color:#61756a;margin-bottom:16px}.home-paper-label>span:last-child{margin-left:auto}.home-dot{width:6px;height:6px;background:#18674d;border-radius:50%}.home-sample{height:370px;overflow:hidden;background:white;box-shadow:0 12px 30px #1e493514; border-radius:3px}.home-sample :global(.resume-paper){padding:28px;min-height:500px;font-size:8px!important}.home-paper-note{display:flex;gap:12px;align-items:center;position:relative;background:#fff;border:1px solid #e1e8e1;border-radius:10px;padding:16px;margin:-25px -52px 0 35px;box-shadow:0 8px 25px #24462c10;transform:rotate(-2deg)}.home-check{display:grid;place-items:center;width:35px;height:35px;background:#edf5ed;border-radius:50%;color:var(--green)}.home-paper-note strong{font-size:12px;display:block}.home-paper-note div>span{display:block;font-size:10px;color:#738278;margin-top:5px}.home-sample-caption{display:block;text-align:center;font-size:10px;color:#6f8073;margin-top:17px}.home-benefits{border-block:1px solid var(--line);background:#fff}.home-benefits .home-wrap{display:flex;justify-content:space-between;gap:22px;padding-block:24px}.home-benefits span{font-size:12px;color:#768277}.home-benefits strong{font-weight:600;color:#34483c;margin-right:8px}.home-section{padding-block:76px}.home-section-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:30px}.home-page h2{font-size:32px;line-height:1.25;letter-spacing:-1px;margin-bottom:14px}.home-section-heading p{max-width:360px;font-size:14px;color:#728078;margin-bottom:14px}.home-tools{display:grid;grid-template-columns:1fr 1fr;gap:24px}.home-tool{border:1px solid #dee5df;border-radius:14px;padding:34px;background:#fff}.home-tool-tint{background:#f0f5ef}.home-tool-icon{display:grid;place-items:center;width:46px;height:46px;border:1px solid #dce7dd;border-radius:10px;font-size:26px;color:var(--green);background:#f7faf6;margin-bottom:24px}.home-tool-label{font-size:10px;letter-spacing:1.5px;color:#728078;font-weight:600}.home-tool h3{font-size:24px;letter-spacing:-.7px;margin:12px 0}.home-tool p{font-size:14px;color:#64746a;max-width:430px}.home-tool ul{list-style:none;padding:0;margin:22px 0 28px;font-size:13px}.home-tool li{margin:12px 0}.home-tool li:before{content:'✓';margin-right:10px;color:var(--green)}.home-tool small{display:block;color:#738078;font-size:11px;margin-top:13px}.home-process{background:#f0f3ef;border-block:1px solid #e7ece6}.home-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:55px;margin-top:38px}.home-steps article>span{display:block;font-size:13px;color:#708675;border-bottom:1px solid #d5dfd5;padding-bottom:18px;margin-bottom:23px}.home-steps h3{font-size:19px;margin-bottom:10px}.home-steps p{font-size:14px;color:#6e7a70;margin:0}.home-template-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:23px}.home-template{border:1px solid #dfe6df;border-radius:11px;overflow:hidden;background:#fff;transition:transform .2s,box-shadow .2s}.home-template:hover{transform:translateY(-4px);box-shadow:0 12px 24px #23442b0d}.home-template-preview{background:#edf1ed;padding:25px 25px 0;height:290px;overflow:hidden}.home-template:nth-child(2) .home-template-preview{background:#efeee8}.home-template:nth-child(3) .home-template-preview{background:#e9eff0}.home-template-preview :global(.resume-paper){font-size:6px!important;padding:23px;min-height:370px;box-shadow:0 4px 16px #203a2c0a}.home-template-info{display:flex;align-items:center;justify-content:space-between;padding:21px}.home-template h3{font-size:16px;margin-bottom:5px}.home-template p{font-size:12px;color:#778179;margin:0}.home-template-info>span{color:var(--green);font-size:23px}.home-caption{font-size:12px;color:#7a867d;margin-top:20px}.home-country{background:#183e30;color:#fff;border-radius:16px;padding:42px;display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.home-country .eyebrow{color:#afcdb4}.home-country h2{font-size:33px}.home-country p{color:#bed0c4;font-size:14px}.home-country-links a{display:flex;align-items:center;gap:14px;padding:13px 0;border-bottom:1px solid #ffffff20;font-size:14px}.home-country-links a:last-child{border:0}.home-country-links a>span{font-size:10px;letter-spacing:1px;background:#ffffff12;border-radius:4px;padding:6px;width:35px;text-align:center;color:#c5dbca}.home-country-links b{margin-left:auto;font-weight:400}.home-country-links a:hover{color:#c7e4c7}.home-faq{display:grid;grid-template-columns:.8fr 1.2fr;gap:65px}.home-faq details{border-bottom:1px solid #dfe5df;padding:20px 0}.home-faq details:first-child{padding-top:0}.home-faq summary{cursor:pointer;font-size:15px;font-weight:500;line-height:1.5}.home-faq details p{font-size:14px;color:#708075;margin:15px 0 0}.home-final{border-top:1px solid #dce5dd;display:flex;align-items:center;justify-content:space-between;gap:35px;padding-block:45px 65px}.home-final h2{font-size:27px}.home-final p{color:#748177;font-size:14px;margin:0}.home-final .button{padding:15px 22px}@media(max-width:1000px){.home-hero{gap:40px}.home-hero h1{font-size:45px}.home-benefits .home-wrap{flex-wrap:wrap}.home-country{gap:35px}.home-paper-note{margin-right:-40px}}@media(max-width:700px){.home-hero{grid-template-columns:1fr;padding-block:45px;gap:40px}.home-hero h1{font-size:43px;letter-spacing:-1.8px}.home-showcase{max-width:430px;width:95%;margin:auto;transform:none}.home-paper-note{margin-right:-22px}.home-section{padding-block:48px}.home-section-heading{display:block}.home-page h2{font-size:27px}.home-tools,.home-steps,.home-template-grid,.home-country,.home-faq{grid-template-columns:1fr}.home-tool{padding:25px}.home-steps{gap:28px}.home-template-grid{gap:20px}.home-template-preview{height:275px;padding-inline:45px}.home-template-preview :global(.resume-paper){font-size:8px!important}.home-country{padding:28px;gap:22px}.home-faq{gap:22px}.home-final{flex-direction:column;align-items:flex-start}.home-benefits .home-wrap{gap:15px;flex-direction:column}.home-reassurance{flex-wrap:wrap}.home-hero-copy>p{font-size:16px}}@media(prefers-reduced-motion:reduce){.home-template{transition:none}}
</style>
