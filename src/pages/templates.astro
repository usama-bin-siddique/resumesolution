---
import Layout from '../layouts/Layout.astro';
import ResumePreview from '../components/ResumePreview';
import {templates,example} from '../lib/resume';
---
<Layout title="Free Resume Templates" active="templates" description="Six free, single-column resume templates. Choose a clean professional layout, customize your details, and download a PDF without signing up."><main id="main" class="content-page"><div class="page-heading"><span class="eyebrow">YOUR EXPERIENCE, BEAUTIFULLY PRESENTED</span><h1>A strong first impression.<br/>A style that feels like you.</h1><p>Six considered layouts. Every one free. Choose a starting point and make it your own.</p></div><div class="template-grid">{templates.map(t=><article class="template-card"><div class="sample-area" aria-hidden="true"><ResumePreview resume={{...example,template:t.id}} mini/></div><div class="template-card-body"><div style="display:flex;justify-content:space-between;align-items:center"><h2>{t.name}</h2><span class="tag">FREE</span></div><p>{t.tag} · Single column</p><a href={`/builder/?template=${t.id}`} class="button secondary full">Use this template <span aria-hidden="true">→</span></a></div></article>)}</div><div class="article-note"><strong>Designed for clear reading.</strong><p style="margin-bottom:0">Our templates use standard sections and selectable PDF text. No template can guarantee an ATS result or an interview. Always follow the employer’s application instructions.</p></div></main></Layout>
